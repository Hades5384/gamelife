<!DOCTYPE html>
<html lang="es" data-theme="dark-minimal">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>gamelife.dev | Tu vida en un juego</title>
    <!-- Fuentes Pixel Art -->
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="css/systems.css">
    <link rel="shortcut icon" href="assets/favicon.svg" type="image/x-icon">
    <style>
        /* ==============================================================
           HOTFIX V4: ARMONÍA, RESPIRACIÓN (SPACING) Y CORRECCIÓN DE FUENTES
           ============================================================== */
        
        /* 1. Prevenir que el navegador destroce las fuentes de píxeles aplicando 'fake bold' */
        h1, h2, h3, h4, h5, h6, 
        .btn-menu, .btn-pixel, .btn-nav, 
        .font-bold, #display-name, .hud-text,
        .stat-label span:last-child {
            font-weight: normal !important;
        }

        /* 2. Top Navigation Bar (Header) - Alineación y Espaciado Premium */
        .top-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 40px; /* Respiración */
            background: var(--panel-bg);
            border-bottom: 4px solid var(--border-color);
            gap: 20px;
            flex-wrap: wrap;
        }

        .header-section {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .header-center {
            flex-grow: 1;
            justify-content: center;
        }

        /* 3. Textos del Héroe (Header Izquierdo) */
        #display-name {
            font-size: 1.2rem; /* Tamaño coherente en 8-bits */
            margin: 0 0 10px 0;
            color: var(--text-color);
            text-shadow: 2px 2px 0px rgba(0,0,0,0.8);
            letter-spacing: 1px;
        }

        .level-badge {
            font-family: 'Pixelify Sans', sans-serif;
            font-size: 0.95rem;
            color: var(--text-dim);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .level-badge span#hud-level-text {
            font-family: 'Press Start 2P', monospace;
            color: var(--primary-color);
            font-size: 0.85rem;
        }

        /* 4. Barra de Salud Central */
        .hp-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px; /* Separar texto de la barra */
        }

        .hp-label {
            font-size: 1rem;
            color: var(--text-color);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .hud-bar-container {
            width: 320px; /* Barra ancha e imponente */
            height: 18px;
            border: 2px solid var(--border-color);
            background: var(--bg-color);
        }

        /* 5. Economía (Header Derecho) */
        .currency-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
        }

        /* 6. Dashboard Grid - Separación general (Armonía) */
        .dashboard {
            padding: 40px !important; /* Más espacio a los lados de la pantalla */
            gap: 40px !important;     /* Más espacio entre las 3 columnas */
        }

        /* 7. Columnas Laterales (Sidebars) */
        .sidebar {
            padding: 30px !important; /* Respiración interior en los paneles */
            display: flex;
            flex-direction: column;
            gap: 15px; /* Separación entre botones */
        }

        .btn-menu {
            padding: 18px 20px !important; /* Botones más altos y cómodos */
            border-radius: 4px;
            font-size: 0.85rem !important;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .panel-title {
            font-size: 1.1rem;
            text-align: center;
            margin-bottom: 30px; /* Separar el título del contenido */
            padding-bottom: 15px;
            border-bottom: 2px dashed var(--border-color);
            letter-spacing: 1px;
            color: var(--text-color);
        }

        .stat-group {
            margin-bottom: 25px; /* Espaciado entre atributos */
        }

        .stat-label {
            margin-bottom: 12px;
            font-family: 'Pixelify Sans', sans-serif;
            font-size: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stat-label .sprite-icon {
            margin-right: 10px;
        }

        /* 8. Responsividad (Móvil) */
        @media (max-width: 950px) {
            .top-nav {
                flex-direction: column;
                padding: 20px;
                text-align: center;
                gap: 25px;
            }
            .header-section {
                flex-direction: column;
                width: 100%;
                justify-content: center;
            }
            .header-right {
                flex-direction: row;
                flex-wrap: wrap;
            }
            .dashboard {
                padding: 15px !important;
                gap: 20px !important;
            }
            .hud-bar-container { width: 100%; max-width: 320px; }
        }
    </style>
</head>

<body>
    <!-- Efecto CRT Retro -->
    <div class="crt-overlay"></div>

    <!-- HEADER PREMIUM (Top Nav) -->
    <header class="top-nav">
        
        <!-- Izquierda: Identidad -->
        <div class="header-section">
            <div style="text-align: left;">
                <h3 id="display-name">CREATOR</h3>
                <div class="level-badge">
                    <span id="hud-equipped-title">Héroe Activo</span> | Nivel <span id="hud-level-text">1</span>
                </div>
            </div>
        </div>
        
        <!-- Centro: Vida -->
        <div class="header-section header-center">
            <div class="hp-container">
                <div class="hp-label">Salud / HP <span id="hud-hp-text"></span></div>
                <div class="hud-bar-container">
                    <div class="hud-hp-fill" id="hud-hp-fill" style="width: 100%; height: 100%; background: var(--hp-color);"></div>
                </div>
            </div>
        </div>
        
        <!-- Derecha: Economía y Controles -->
        <div class="header-section header-right">
            <span class="currency-item" style="color: var(--tier-gold, #ffd700);" title="Oro">
                <img src="assets/coin.png" class="sprite-icon small"> <span id="hud-gold-text">0</span>
            </span>
            <span class="currency-item" style="color: #00FFFF;" title="Racha">
                <img src="assets/streak.png" class="sprite-icon small"> <span id="hud-streak-text">0</span>
            </span>
            <span class="currency-item" style="color: #A3BE8C;" title="Escudos">
                <i class="icon-pixel icon-shield" style="margin-right: 8px;"></i> <span id="hud-shield-text">0/2</span>
            </span>
            
            <button class="btn-pixel currency-item" onclick="openModal('theme-modal')" title="Configurar Apariencia" style="padding: 12px 15px;">
                <img src="assets/settings.png" class="sprite-icon small" style="margin:0;"> TEMAS
            </button>
            <button class="btn-nav currency-item" onclick="openModal('save-modal')" style="color: var(--tier-gold, #ffd700); border-color: var(--tier-gold, #ffd700); padding: 12px 15px;" title="Guardar">
                <img src="assets/save.png" class="sprite-icon small" style="margin:0;"> SAVE
            </button>
        </div>
    </header>

    <!-- REPRODUCTOR DE MÚSICA -->
    <div class="music-widget" id="music-widget">
        <button class="music-badge" id="music-badge" title="Reproductor de Audio">
            <svg class="pixel-disc-icon" viewBox="0 0 16 16">
                <rect x="5" y="1" width="6" height="1" />
                <rect x="3" y="2" width="10" height="1" />
                <rect x="2" y="3" width="12" height="2" />
                <rect x="1" y="5" width="14" height="6" />
                <rect x="2" y="11" width="12" height="2" />
                <rect x="3" y="13" width="10" height="1" />
                <rect x="5" y="14" width="6" height="1" />
                <rect x="7" y="6" width="2" height="4" fill="var(--bg-color)" />
                <rect x="6" y="7" width="4" height="2" fill="var(--bg-color)" />
            </svg>
            <span class="music-badge-label">AUDIO</span>
        </button>
        <div class="music-card">
            <div class="spotify-header">
                <div class="spotify-title">> NOW_PLAYING</div>
            </div>
            <div class="spotify-body">
                <div class="player-controls">
                    <button class="btn-pixel-icon" id="btn-sound" onclick="toggleSound()">
                        <svg viewBox="0 0 16 16" width="14" height="14" shape-rendering="crispEdges" fill="currentColor">
                            <rect x="1" y="6" width="3" height="4" />
                            <rect x="4" y="5" width="1" height="6" />
                            <rect x="5" y="4" width="1" height="8" />
                            <rect x="6" y="3" width="2" height="10" />
                            <rect x="10" y="5" width="1" height="6" />
                            <rect x="12" y="3" width="1" height="10" />
                        </svg>
                    </button>
                    <div class="player-screen">
                        <select id="bgm-select" class="pixel-select-mini" onchange="changeBGM()">
                            <option value="1">[&gt;] T1: Aldea</option>
                            <option value="2">[&gt;] T2: Taberna</option>
                            <option value="3">[&gt;] T3: Crunchy</option>
                            <option value="0">[||] Solo Efectos</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DASHBOARD GRID -->
    <div class="dashboard">
        
        <!-- COLUMNA IZQUIERDA: MENÚ -->
        <aside class="sidebar panel">
            <button class="btn-menu active" onclick="showPanel('missions')"><img src="assets/misions.png" class="sprite-icon" style="margin:0;"> MISIONES</button>
            <button class="btn-menu" onclick="showPanel('base')"><img src="assets/stats.png" class="sprite-icon" style="margin:0;"> STATS</button>
            <button class="btn-menu" onclick="openModal('profile-modal')"><img src="assets/profile.png" class="sprite-icon" style="margin:0;"> PERFIL</button>
            <button class="btn-menu" onclick="ChronicleUI.open()"><img src="assets/goals.png" class="sprite-icon" style="margin:0;"> LOGROS</button>
            
            <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 40px;" class="mobile-hide">
                <button class="btn-menu" style="color: var(--text-dim); opacity: 0.6;"><img src="assets/cash.png" class="sprite-icon" style="margin:0;"> TIENDA</button>
                <button class="btn-menu" style="color: var(--text-dim); opacity: 0.6;"><img src="assets/guild.png" class="sprite-icon" style="margin:0;"> GREMIO</button>
            </div>
        </aside>

        <!-- COLUMNA CENTRAL: MISIONES Y BASE -->
        <main class="main-content panel" id="main-column" style="padding: 40px;">
            <!-- TAB: MISIONES -->
            <div class="panel-missions tab-view active" id="view-missions">
                <div class="panel-title">MISIONES DEL DÍA</div>
                <div id="missions-container"></div>
                <button class="btn-pixel" onclick="openModal('mission-modal')" style="width: 100%; margin-top: 30px; padding: 25px; font-weight: normal; background-color: var(--bg-color); color: var(--primary-color); border: 2px dashed var(--primary-color); font-size: 1rem; letter-spacing: 1px;">[+] NUEVA MISIÓN</button>
            </div>

            <!-- TAB: MI BASE -->
            <div class="panel-base tab-view" id="view-base" style="display: none; height: 100%;">
                <div class="panel-title">[ SANTUARIO DEL HÉROE ]</div>
                <div id="base-viewport" style="width: 100%; height: calc(100% - 60px); background: #111; position: relative; border: 4px solid var(--border-color); box-shadow: inset 4px 4px 0px rgba(0,0,0,0.8); overflow: hidden; image-rendering: pixelated; border-radius: 2px;"></div>
            </div>
        </main>

        <!-- COLUMNA DERECHA: ATRIBUTOS Y RECOMPENSAS -->
        <aside class="sidebar panel">
            <div style="position: relative;">
                <div class="panel-title">ATRIBUTOS DEL HÉROE</div>
                <button onclick="openModal('stats-modal')" title="Configurar Stats" style="position: absolute; right: 0; top: -5px; background: none; border: none; cursor: pointer; opacity: 0.7;">
                    <img src="assets/settings.png" class="sprite-icon small" style="margin:0;">
                </button>
            </div>
            
            <div class="stat-group">
                <div class="stat-label">
                    <span><img src="assets/force.png" class="sprite-icon small" style="margin:0 8px 0 0;">Fuerza (Físico)</span>
                    <span id="text-fuerza" style="color: var(--primary-color); font-family: 'Press Start 2P', monospace; font-size: 0.75rem;">Lvl 1</span>
                </div>
                <div class="stat-bar-container" style="height: 14px; background: var(--bg-color); border: 2px solid var(--border-color);">
                    <div class="stat-bar-fill stat-fuerza" id="bar-fuerza" style="height: 100%; background: #bf616a;"></div>
                </div>
            </div>
            
            <div class="stat-group">
                <div class="stat-label">
                    <span>🧠 Intelecto (Estudio)</span>
                    <span id="text-sabiduria" style="color: var(--primary-color); font-family: 'Press Start 2P', monospace; font-size: 0.75rem;">Lvl 1</span>
                </div>
                <div class="stat-bar-container" style="height: 14px; background: var(--bg-color); border: 2px solid var(--border-color);">
                    <div class="stat-bar-fill stat-sabiduria" id="bar-sabiduria" style="height: 100%; background: #5e81ac;"></div>
                </div>
            </div>
            
            <div class="stat-group">
                <div class="stat-label">
                    <span>💚 Espíritu (Mental)</span>
                    <span id="text-creatividad" style="color: var(--primary-color); font-family: 'Press Start 2P', monospace; font-size: 0.75rem;">Lvl 1</span>
                </div>
                <div class="stat-bar-container" style="height: 14px; background: var(--bg-color); border: 2px solid var(--border-color);">
                    <div class="stat-bar-fill stat-creatividad" id="bar-creatividad" style="height: 100%; background: #a3be8c;"></div>
                </div>
            </div>
            
            <div class="stat-group">
                <div class="stat-label">
                    <span>🤝 Social (Familia)</span>
                    <span id="text-carisma" style="color: var(--primary-color); font-family: 'Press Start 2P', monospace; font-size: 0.75rem;">Lvl 1</span>
                </div>
                <div class="stat-bar-container" style="height: 14px; background: var(--bg-color); border: 2px solid var(--border-color);">
                    <div class="stat-bar-fill stat-carisma" id="bar-carisma" style="height: 100%; background: #d08770;"></div>
                </div>
            </div>

            <hr style="border: 1px solid var(--border-color); margin: 40px 0 30px 0; opacity: 0.5;">
            
            <div class="panel-title" style="margin-bottom: 20px; font-size: 1rem;">INVENTARIO DE RECOMPENSAS</div>
            <div style="font-family: 'Pixelify Sans', sans-serif; font-size: 0.95rem; margin-bottom: 25px; color: var(--text-dim); text-align: center;">Gastar el oro ganado:</div>
            
            <div id="shop-container" style="display: flex; flex-direction: column; gap: 12px;"></div>
        </aside>
    </div>

    <!-- Script de navegación de tabs -->
    <script>
        function showPanel(panelName) {
            document.querySelectorAll('.tab-view').forEach(el => el.style.display = 'none');
            document.getElementById('view-' + panelName).style.display = 'block';
            
            if (event && event.currentTarget) {
                document.querySelectorAll('.btn-menu').forEach(btn => btn.classList.remove('active'));
                event.currentTarget.classList.add('active');
            }
            
            if(panelName === 'base' && window.BaseUI && window.BaseUI.renderV4) {
                window.BaseUI.renderV4();
            }
        }
    </script>

    <!-- TOAST GENÉRICO -->
    <div id="generic-toast" class="level-toast">
        <h2 id="toast-title">MENSAJE</h2>
        <p id="toast-message">Texto aquí</p>
    </div>

    <!-- NOTIFICACIÓN DE SUBIDA DE NIVEL -->
    <div id="level-up-toast" class="level-toast">
        <h2>
            <svg viewBox="0 0 16 16" width="18" height="18" shape-rendering="crispEdges" fill="currentColor"
                style="vertical-align: text-bottom; margin-right: 6px;">
                <rect x="7" y="0" width="2" height="2" />
                <rect x="5" y="2" width="6" height="2" />
                <rect x="3" y="4" width="10" height="2" />
                <rect x="5" y="6" width="6" height="2" />
                <rect x="7" y="8" width="2" height="2" />
            </svg>
            [ LEVEL UP ]
        </h2>
        <p id="level-up-message">Subiste a Nivel 2</p>
    </div>

    <!-- MODAL DE CONFIRMACIÓN -->
    <div class="modal-overlay" id="confirm-modal">
        <div class="modal-content" style="max-width: 400px; text-align: center;">
            <div class="panel-title" style="margin-bottom: 25px;">> SISTEMA</div>
            <p id="confirm-message" style="color: var(--text-color); font-family: 'Pixelify Sans', sans-serif; font-size: 1.1rem; margin-bottom: 35px; line-height: 1.6;">¿Seguro que deseas proceder?</p>
            <div style="display: flex; gap: 20px; justify-content: center;">
                <button class="btn-pixel" onclick="confirmYes()" style="background-color: var(--primary-color); color: var(--bg-color); padding: 15px 25px;">SÍ, PROCEDER</button>
                <button class="btn-pixel" onclick="closeModal('confirm-modal')" style="border-color: #EF4444; color: #EF4444; padding: 15px 25px;">CANCELAR</button>
            </div>
        </div>
    </div>

    <!-- MODAL: NUEVA MISIÓN -->
    <div class="modal-overlay" id="mission-modal">
        <div class="modal-content">
            <div class="modal-header-flex" style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 30px;">
                <div class="panel-title" style="margin:0; border:none; padding:0;">> NUEVA_MISIÓN</div>
                <button class="btn-pixel-close" onclick="closeModal('mission-modal')" title="Cerrar">X</button>
            </div>
            <div class="edit-profile-box" style="display:flex; flex-direction:column; gap: 15px;">
                <label style="font-family:'Pixelify Sans', sans-serif; font-size:1.1rem;">> Título de la tarea:</label>
                <input type="text" id="new-mission-name" placeholder="Ej: Entrenar tren superior" class="pixel-input" style="padding:15px; margin-bottom:10px;">

                <label style="font-family:'Pixelify Sans', sans-serif; font-size:1.1rem;">> Atributo que mejora:</label>
                <select id="new-mission-stat" class="pixel-select" style="padding:15px; margin-bottom:10px;">
                    <option value="fuerza">Fuerza</option>
                    <option value="sabiduria">Sabiduría</option>
                    <option value="creatividad">Creatividad</option>
                    <option value="carisma">Carisma</option>
                </select>

                <label style="font-family:'Pixelify Sans', sans-serif; font-size:1.1rem;">> Dificultad (XP Fija):</label>
                <select id="new-mission-level" class="pixel-select" style="padding:15px; margin-bottom:25px;">
                    <option value="1">Nivel 1 (Fácil) - 10 XP</option>
                    <option value="2" selected>Nivel 2 (Medio) - 20 XP</option>
                    <option value="3">Nivel 3 (Difícil) - 35 XP</option>
                    <option value="4">Nivel 4 (Épico) - 50 XP</option>
                </select>

                <button class="btn-pixel" onclick="saveNewMission()" style="padding:20px; font-size:1rem; background: var(--primary-color); color: var(--bg-color);">Crear Misión</button>
            </div>
        </div>
    </div>

    <!-- MODAL: EDITAR PERFIL -->
    <div class="modal-overlay" id="profile-modal">
        <div class="modal-content">
            <div class="modal-header-flex" style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 30px;">
                <div class="panel-title" style="margin:0; border:none; padding:0;">> EDITAR_PERFIL</div>
                <button class="btn-pixel-close" onclick="closeModal('profile-modal')" title="Cerrar">X</button>
            </div>
            <div class="edit-profile-box scroll-box" style="display:flex; flex-direction:column; gap: 15px;">
                <label style="font-family:'Pixelify Sans', sans-serif; font-size:1.1rem;">> Cambiar Nombre:</label>
                <input type="text" id="input-name" placeholder="Tu Nombre / Nick" oninput="updateProfileLive()" class="pixel-input" style="padding:15px;">

                <label style="font-family:'Pixelify Sans', sans-serif; font-size:1.1rem;">> Descripción corta (Bio):</label>
                <textarea id="input-bio" placeholder="Escribe tu objetivo..." oninput="updateProfileLive()" class="pixel-input" style="padding:15px; height:80px;"></textarea>

                <label style="font-family:'Pixelify Sans', sans-serif; font-size:1.1rem;">> URL de Avatar:</label>
                <input type="text" id="input-avatar" placeholder="https://..." oninput="updateProfileLive()" class="pixel-input" style="padding:15px;">

                <label style="font-family:'Pixelify Sans', sans-serif; font-size:1.1rem;">> Archivo Local (O Ctrl+V):</label>
                <div class="drop-zone" id="avatar-drop-zone" onclick="document.getElementById('input-file').click()" style="padding:30px; border:2px dashed var(--primary-color); text-align:center; cursor:pointer;">
                    <div id="file-label" class="drop-zone-text" style="font-family:'Pixelify Sans', sans-serif;">[+] Haz Clic, Arrastra o Pega tu Avatar aquí</div>
                    <input type="file" id="input-file" accept="image/*,.gif" onchange="handleFileSelect(event)" style="display: none;">
                </div>
            </div>
            <button class="btn-pixel" onclick="closeModal('profile-modal')" style="margin-top: 25px; width: 100%; padding: 15px;">Guardar y Cerrar</button>
        </div>
    </div>

    <!-- MODAL: CONFIGURAR TEMAS Y APARIENCIA -->
    <div class="modal-overlay" id="theme-modal">
        <div class="modal-content" style="max-width: 480px;">
            <div class="modal-header-flex" style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 30px;">
                <div class="panel-title" style="margin:0; border:none; padding:0;">> APARIENCIA_Y_TEMAS</div>
                <button class="btn-pixel-close" onclick="closeModal('theme-modal')" title="Cerrar">X</button>
            </div>
            <div class="edit-profile-box" style="display:flex; flex-direction:column; gap: 15px;">
                <label style="font-family:'Pixelify Sans', sans-serif; font-size:1.1rem;">> Selecciona un tema visual:</label>
                <div class="theme-grid-modal" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <button class="btn-pixel" onclick="setTheme('terminal')" style="padding:15px;">Terminal</button>
                    <button class="btn-pixel" onclick="setTheme('synthwave')" style="padding:15px;">Synthwave</button>
                    <button class="btn-pixel" onclick="setTheme('matrix')" style="padding:15px;">Matrix</button>
                    <button class="btn-pixel" onclick="setTheme('light-minimal')" style="padding:15px;">Light Min</button>
                    <button class="btn-pixel" onclick="setTheme('dark-minimal')" style="padding:15px;">Dark Min</button>
                    <button class="btn-pixel" onclick="setTheme('rpg-retro')" style="padding:15px;">RPG Retro</button>
                </div>

                <label style="font-family:'Pixelify Sans', sans-serif; font-size:1.1rem; margin-top:20px;">> Fondo Personalizado:</label>
                <button class="btn-pixel" onclick="closeModal('theme-modal'); openModal('bg-modal');" style="width: 100%; border-color: var(--primary-color); color: var(--primary-color); padding: 15px;">
                    CONFIGURAR FONDO DEL TEMA
                </button>
            </div>
            <button class="btn-pixel" onclick="closeModal('theme-modal')" style="margin-top: 25px; width: 100%; padding: 15px;">LISTO</button>
        </div>
    </div>

    <!-- MODAL: GESTIÓN DE PARTIDA (SAVE) -->
    <div class="modal-overlay" id="save-modal">
        <div class="modal-content">
            <div class="modal-header-flex" style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 30px;">
                <div class="panel-title" style="margin:0; border:none; padding:0;">> GESTIÓN_DE_PARTIDA</div>
                <button class="btn-pixel-close" onclick="closeModal('save-modal')" title="Cerrar">X</button>
            </div>
            <div class="edit-profile-box" style="display:flex; flex-direction:column; gap: 15px;">
                <button class="btn-pixel" style="width:100%; padding: 15px; border-color: var(--primary-color);" onclick="SaveSystem.createSavePoint()">
                    Crear Punto de Guardado
                </button>
                <button class="btn-pixel" style="width:100%; padding: 15px;" onclick="SaveSystem.restoreSavePoint()">
                    Restaurar Punto de Guardado
                </button>
                <button class="btn-pixel" style="width:100%; padding: 15px;" onclick="SaveSystem.exportData()">
                    Exportar (.json)
                </button>
                <button class="btn-pixel" style="width:100%; padding: 15px;" onclick="document.getElementById('import-file').click()">
                    Importar (.json)
                </button>
                <input type="file" id="import-file" accept=".json" onchange="SaveSystem.importData(event)" style="display:none;">
                
                <hr style="border: 1px dashed var(--border-color); margin: 15px 0;">
                
                <button class="btn-pixel" style="width:100%; padding: 15px; border-color: #e74c3c; color: #e74c3c;" onclick="SaveSystem.newGame()">
                    Nueva Partida
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: CRÓNICAS DEL HÉROE -->
    <div class="modal-overlay" id="chronicle-modal">
        <div class="modal-content" style="max-width: 600px;">
            <div class="modal-header-flex" style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 30px;">
                <div class="panel-title" style="margin:0; border:none; padding:0;">> CRÓNICAS_DEL_HÉROE</div>
                <button class="btn-pixel-close" onclick="closeModal('chronicle-modal')" title="Cerrar">X</button>
            </div>
            <div class="chronicle-tabs" style="display:flex; gap:10px; margin-bottom:20px; border-bottom: 2px dashed var(--border-color); padding-bottom:15px; overflow-x: auto;">
                <button class="btn-pixel btn-tab" id="btn-tab-medals" onclick="ChronicleUI.switchTab('medals')" style="padding:15px;">Medallas</button>
                <button class="btn-pixel btn-tab" id="btn-tab-titles" onclick="ChronicleUI.switchTab('titles')" style="padding:15px;">Títulos</button>
                <button class="btn-pixel btn-tab" id="btn-tab-history" onclick="ChronicleUI.switchTab('history')" style="padding:15px;">Crónica</button>
            </div>
            <div class="edit-profile-box scroll-box" style="height: 350px; overflow-y: auto;">
                <div id="tab-medals-content" class="chronicle-tab"></div>
                <div id="tab-titles-content" class="chronicle-tab" style="display:none;"></div>
                <div id="tab-history-content" class="chronicle-tab" style="display:none;"></div>
            </div>
        </div>
    </div>

    <!-- Scripts JRPG -->
    <script src="js/core/utils.js"></script>
    <script src="js/core/bus.js"></script>
    <script src="js/core/state.js"></script>
    <script src="js/audio.js"></script>
    <script src="js/ui/toasts.js"></script>
    <script src="js/ui/modals.js"></script>
    <script src="js/systems/profile.js"></script>
    <script src="js/systems/missions.js"></script>
    <script src="js/systems/rest.js"></script>
    <script src="js/systems/day-engine.js"></script>
    <script src="js/systems/hero.js"></script>
    <script src="js/systems/streak.js"></script>
    <script src="js/systems/achievements.js"></script>
    <script src="js/systems/titles.js"></script>
    <script src="js/systems/history.js"></script>
    <script src="js/systems/save.js"></script>
    <script src="js/systems/economy.js"></script>
    <script src="js/systems/base.js"></script>
    <script src="js/ui/fx.js"></script>
    <script src="js/ui/hud.js"></script>
    <script src="js/ui/chronicle.js"></script>
    <script src="js/main-v3.js"></script>
</body>
</html>


